# GoWellWith (Paired) Social-Commerce Stripe Connect Configuration
# If Stripe keys are omitted or blank, the system automatically runs in high-fidelity Demo Mode.
# To test with real Stripe Connect Test Mode, provide your Stripe Test API keys:

PORT=3000
NODE_ENV=development

# Stripe API Keys (Get from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Stripe Webhook Signing Secret (Get from Stripe CLI or Dashboard > Webhooks)
STRIPE_WEBHOOK_SECRET=

# Stripe Connect Client ID (Optional, for OAuth-based onboarding)
STRIPE_CONNECT_CLIENT_ID=
